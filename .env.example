# Qloo — "mock" runs on the bundled synthetic graph; "live" needs a key.
QLOO_MODE=mock
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Any OpenAI-compatible chat model with tool calling. Leave blank to run the
# deterministic planner (same Qloo tools, fixed order).
# Gemini example:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
