# Qloo — "mock" runs on the bundled synthetic graph; "live" needs a key.
QLOO_MODE=mock
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Any OpenAI-compatible chat model with tool calling. Leave blank to run the
# deterministic planner (same Qloo tools, fixed order).
# Default: OpenRouter free models ($0), with automatic fallback when one is busy.
# Free tier is rate-limited; on a 429 the app pauses the LLM and uses the deterministic planner.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free
