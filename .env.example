# Qloo — "mock" runs on the bundled synthetic graph; "live" needs a key.
QLOO_MODE=mock
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Any OpenAI-compatible chat model with tool calling. Leave blank to run the
# deterministic planner (same Qloo tools, fixed order).
# Default: OpenRouter free models ($0), with automatic fallback when one is busy.
# Free tier is rate-limited; on a 429 the app pauses the LLM and uses the deterministic planner.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free
# Optional second provider, tried after the whole primary chain fails.
# Any OpenAI-compatible endpoint, e.g. Amazon Bedrock's OpenAI-compatible API:
#   LLM2_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
LLM2_BASE_URL=
LLM2_API_KEY=
LLM2_MODEL=
# Total time the LLM planner may spend per run before autopilot takes over (ms).
LLM_RUN_BUDGET_MS=45000

# Optional shared state across serverless instances (Upstash Redis REST, no SDK).
# When both are set: result cache, Qloo response cache and rate limits live in Redis
# with a TTL of at most 6 hours. When blank: in-memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SITE_HOST=
