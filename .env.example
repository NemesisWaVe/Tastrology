# Qloo — "mock" runs on the bundled synthetic graph; "live" needs a key.
QLOO_MODE=mock
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Chain: LLM_* (all its models) -> LLM2_* -> LLM3_* -> deterministic planner.
# Primary: Amazon Bedrock, OpenAI-compatible endpoint (Bedrock API key).
LLM_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai.gpt-oss-120b-1:0
LLM_FALLBACK_MODELS=openai.gpt-oss-20b-1:0
# Second: Amazon Nova Pro. Amazon models go through Bedrock's Converse API automatically.
LLM2_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com
LLM2_API_KEY=
LLM2_MODEL=amazon.nova-pro-v1:0
# Third: OpenRouter free models (50 requests/day on a free account).
LLM3_BASE_URL=https://openrouter.ai/api/v1
LLM3_API_KEY=
LLM3_MODEL=nvidia/nemotron-3.5-lightning:free
# Total time the LLM planner may spend per run before autopilot takes over (ms).
LLM_RUN_BUDGET_MS=45000

# Optional shared state across serverless instances (Upstash Redis REST, no SDK).
# When both are set: result cache, Qloo response cache and rate limits live in Redis
# with a TTL of at most 6 hours. When blank: in-memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SITE_HOST=

# Max tokens per LLM reply.
LLM_MAX_TOKENS=1536
# LLM calls per UTC day across all users; past it, runs use the deterministic planner.
LLM_DAILY_MAX=2500

# Optional S3 bucket for card twins (private, write-once). Names avoid AWS_*: Vercel reserves those.
S3_BUCKET=
# Bucket region.
S3_REGION=us-east-1
# Access key of an IAM user limited to Get/Put on twins/*.
S3_ACCESS_KEY_ID=
# Secret for that access key.
S3_SECRET_ACCESS_KEY=

# Random string mixed into hashed client IPs for rate limits.
RL_SALT=
